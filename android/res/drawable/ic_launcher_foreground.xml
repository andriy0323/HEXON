<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">

    <!-- Centred hex logo. The adaptive icon background fills the
         outer ring, so we only need to paint the hex itself. -->
    <group android:translateX="0"
           android:translateY="0">
        <path
            android:fillType="evenOdd"
            android:pathData="M54,28 L74,40 L74,68 L54,80 L34,68 L34,40 Z">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="34" android:startY="34"
                    android:endX="74"   android:endY="74">
                    <item android:offset="0" android:color="#FF7C5CFF" />
                    <item android:offset="1" android:color="#FF24BDFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- inner highlight hex (lighter, smaller) -->
        <path
            android:fillColor="#33FFFFFF"
            android:pathData="M54,40 L66,47 L66,61 L54,68 L42,61 L42,47 Z" />
    </group>
</vector>
